<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>AppIconLight</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIconLight</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>AppIconDark</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIconDark</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>AppIconLight</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIconLight</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>AppIconDark</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIconDark</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.girasol.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>girasol</string>
			</array>
		</dict>
	</array>
	<!-- Girasol's own Keychain group, and Opaline's app id and group, for
	     the one-tap import (OPOpalineImport, OPKeychainGroup). Filled in by
	     the Makefile. -->
	<key>OPKeychainGroup</key>
	<string>$(OP_KEYCHAIN_GROUP)</string>
	<key>OPOpalineIdentifier</key>
	<string>$(OP_OPALINE_ID)</string>
	<key>OPOpalineKeychainGroup</key>
	<string>$(OP_OPALINE_KEYCHAIN_GROUP)</string>
	<key>OPOpalineImport</key>
	<string>$(OP_OPALINE_IMPORT)</string>
	<!-- The default solver server: empty unless built with
	     USE_UPSTREAM_SOLVER=1 (AppURLs.SolverServer). -->
	<key>OPDefaultSolverServer</key>
	<string>$(OP_DEFAULT_SOLVER)</string>
	<!-- The system share sheet offers "Save Video", which writes to Photos.
	     Without this key iOS kills the app the moment that item is tapped.
	     English in every language on purpose: the official app carries no
	     equivalent wording to take a translation from (#115). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>This lets you save a downloaded video to your photo library.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>192.168.31.224</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
